<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Mã số bài hát -->
    <TextView
        android:id="@+id/txtmaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="52300"
        android:textStyle="bold"
        android:textColor="#0000FF"
        android:layout_marginRight="10dp"
        android:textSize="16sp"/>

    <!-- Tiêu đề bài hát -->
    <TextView
        android:id="@+id/txttieude"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Em là ai Tôi là ai"
        android:textSize="16sp"/>

    <!-- FrameLayout chứa các nút -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Nút yêu thích (like) -->
        <ImageButton
            android:id="@+id/btnlike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_like"
            android:contentDescription="Yêu thích"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

        <!-- Nút không thích (unlike) -->
        <ImageButton
            android:id="@+id/btnunlike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_unlike"
            android:contentDescription="Không thích"
            android:layout_marginLeft="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </FrameLayout>

</LinearLayout>
